<launch>
  <!-- Supply the directory produced by odin1-prepare; do not reuse D455 extrinsics. -->
  <arg name="params_folder" />
  <arg name="robot_name" default="odin1" />
  <arg name="robot_id" default="0" />
  <arg name="should_use_sim_time" default="true" />
  <arg name="use_lcd" default="true" />
  <arg name="lcd_no_detection" default="false" />
  <arg name="lcd_no_optimize" default="true" />
  <arg name="path_to_vocab" default="$(find kimera_vio)/vocabulary/ORBvoc.yml" />
  <arg name="log_output" default="false" />
  <arg name="log_output_path" default="$(env HOME)/.ros/odin1_vio" />
  <arg name="verbosity" default="0" />

  <!-- roscpp reads this global parameter, even when the node is namespaced. -->
  <param name="/use_sim_time" value="$(arg should_use_sim_time)" />

  <group ns="$(arg robot_name)">
    <include file="$(find kimera_vio_ros)/launch/kimera_vio_ros.launch">
      <arg name="params_folder" value="$(arg params_folder)" />
      <arg name="robot_id" value="$(arg robot_id)" />
      <!-- Suppress the separate GUI include, retaining standard VIO/LCD publications. -->
      <arg name="multirobot" value="true" />
      <arg name="online" value="true" />
      <arg name="should_use_sim_time" value="$(arg should_use_sim_time)" />
      <arg name="left_cam_topic" value="/$(arg robot_name)/kimera/rgb/image_raw" />
      <arg name="right_cam_topic" value="" />
      <arg name="depth_cam_topic" value="/$(arg robot_name)/kimera/depth/image_raw" />
      <arg name="imu_topic" value="/$(arg robot_name)/kimera/imu" />
      <arg name="use_external_odom" value="false" />
      <arg name="external_odom_topic" value="" />
      <arg name="force_same_image_timestamp" value="false" />
      <arg name="do_coarse_temporal_sync" value="false" />
      <arg name="do_fine_temporal_sync" value="false" />
      <arg name="use_lcd" value="$(arg use_lcd)" />
      <arg name="lcd_no_detection" value="$(arg lcd_no_detection)" />
      <arg name="lcd_no_optimize" value="$(arg lcd_no_optimize)" />
      <arg name="path_to_vocab" value="$(arg path_to_vocab)" />
      <arg name="publish_vlc_frames" value="true" />
      <arg name="bow_batch_size" value="1" />
      <arg name="bow_skip_num" value="1" />
      <arg name="lcd_disable_stereo_match_depth_check" value="false" />
      <arg name="no_incremental_pose" value="false" />
      <arg name="visualize" value="true" />
      <arg name="viz_type" value="2" />
      <!-- Upstream uses this flag to enable ROS publishers, not just the GUI.
           multirobot=true above suppresses the separate graphical launch. -->
      <arg name="use_rviz" value="true" />
      <arg name="log_output" value="$(arg log_output)" />
      <arg name="log_output_path" value="$(arg log_output_path)" />
      <arg name="verbosity" value="$(arg verbosity)" />
      <arg name="odom_frame_id" value="$(arg robot_name)/vio_odom" />
      <arg name="base_link_frame_id" value="$(arg robot_name)/imu" />
      <arg name="map_frame_id" value="$(arg robot_name)/map" />
      <arg name="left_cam_frame_id" value="$(arg robot_name)/camera_optical" />
      <arg name="right_cam_frame_id" value="$(arg robot_name)/camera_optical" />
    </include>
  </group>
</launch>
